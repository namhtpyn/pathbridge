{
  "name": "pathbridge",
  "version": "0.1.0",
  "description": "Configurable path-to-URL forwarding proxy with a built-in admin UI. Route selected paths to external upstreams — useful when an API must be reached from a specific network or region.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "bun .output/server/index.mjs",
    "admin": "bun scripts/create-admin.ts",
    "typecheck": "nuxt typecheck || tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^1.0.0-rc.4",
    "nuxt": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "bun-types": "^1.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "5.9",
    "vue-tsc": "2"
  }
}